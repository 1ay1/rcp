{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/1ay1/rcp/main/schema/rcp-1.0.json",
  "title": "Retrieval Context Protocol 1.0",
  "description": "Normative JSON Schema for all RCP/1 message shapes (SOTA-complete).",

  "$comment": "The root schema validates any single RCP/1 message or a JSON-RPC batch. Per spec §4.6 unknown members are IGNORED, never rejected, so no object here sets additionalProperties:false — forward compatibility is a normative requirement, and a strict schema would make every additive spec revision a breaking change for validators.",
  "oneOf": [
    { "$ref": "#/$defs/Message" },
    { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Message" } }
  ],

  "$defs": {
    "Message": {
      "description": "Any single RCP/1 frame: a request, a notification, or a response (§4).",
      "oneOf": [
        { "$ref": "#/$defs/JsonRpcRequest" },
        { "$ref": "#/$defs/JsonRpcNotification" },
        { "$ref": "#/$defs/JsonRpcSuccess" },
        { "$ref": "#/$defs/JsonRpcError" }
      ]
    },

    "MethodName": {
      "description": "Every method defined by RCP/1 (§7), plus the vendor-extension namespace (§6.2).",
      "anyOf": [
        { "enum": [
          "initialize", "info", "ping", "shutdown",
          "embed", "embed/sparse", "embed/multi",
          "rerank", "retrieve", "query/transform", "graph",
          "index/add", "index/delete", "catalog/list",
          "feedback", "memory/build", "memory/recall"
        ] },
        { "type": "string", "pattern": "^x-[a-z0-9-]+/" }
      ]
    },

    "ResultFor": {
      "description": "§7: binds a method name to the shape of its `result`. A validator cannot infer the method from a bare response frame (JSON-RPC correlates by `id`), so apply this schema explicitly against `{ method, result }` once the pairing is known — e.g. `{ \"$ref\": \"#/$defs/ResultFor\" }` with the method injected by the harness.",
      "type": "object",
      "required": ["method", "result"],
      "properties": { "method": { "$ref": "#/$defs/MethodName" }, "result": { "type": "object" } },
      "allOf": [
        { "if": { "properties": { "method": { "const": "initialize" } }, "required": ["method"] },
          "then": { "properties": { "result": { "$ref": "#/$defs/InitializeResult" } } } },
        { "if": { "properties": { "method": { "const": "info" } }, "required": ["method"] },
          "then": { "properties": { "result": { "$ref": "#/$defs/InitializeResult" } } } },
        { "if": { "properties": { "method": { "const": "ping" } }, "required": ["method"] },
          "then": { "properties": { "result": { "$ref": "#/$defs/PingResult" } } } },
        { "if": { "properties": { "method": { "const": "embed" } }, "required": ["method"] },
          "then": { "properties": { "result": { "$ref": "#/$defs/EmbedResult" } } } },
        { "if": { "properties": { "method": { "const": "embed/sparse" } }, "required": ["method"] },
          "then": { "properties": { "result": { "$ref": "#/$defs/SparseEmbedResult" } } } },
        { "if": { "properties": { "method": { "const": "embed/multi" } }, "required": ["method"] },
          "then": { "properties": { "result": { "$ref": "#/$defs/MultiVectorResult" } } } },
        { "if": { "properties": { "method": { "const": "rerank" } }, "required": ["method"] },
          "then": { "properties": { "result": { "$ref": "#/$defs/RerankResult" } } } },
        { "if": { "properties": { "method": { "const": "retrieve" } }, "required": ["method"] },
          "then": { "properties": { "result": { "$ref": "#/$defs/RetrieveResult" } } } },
        { "if": { "properties": { "method": { "const": "query/transform" } }, "required": ["method"] },
          "then": { "properties": { "result": { "$ref": "#/$defs/TransformResult" } } } },
        { "if": { "properties": { "method": { "const": "graph" } }, "required": ["method"] },
          "then": { "properties": { "result": { "$ref": "#/$defs/GraphResult" } } } },
        { "if": { "properties": { "method": { "const": "index/add" } }, "required": ["method"] },
          "then": { "properties": { "result": { "$ref": "#/$defs/IndexAddResult" } } } },
        { "if": { "properties": { "method": { "const": "index/delete" } }, "required": ["method"] },
          "then": { "properties": { "result": { "$ref": "#/$defs/IndexDeleteResult" } } } },
        { "if": { "properties": { "method": { "const": "catalog/list" } }, "required": ["method"] },
          "then": { "properties": { "result": { "$ref": "#/$defs/CatalogListResult" } } } },
        { "if": { "properties": { "method": { "const": "feedback" } }, "required": ["method"] },
          "then": { "properties": { "result": { "$ref": "#/$defs/FeedbackResult" } } } },
        { "if": { "properties": { "method": { "const": "memory/build" } }, "required": ["method"] },
          "then": { "properties": { "result": { "$ref": "#/$defs/MemoryBuildResult" } } } },
        { "if": { "properties": { "method": { "const": "memory/recall" } }, "required": ["method"] },
          "then": { "properties": { "result": { "$ref": "#/$defs/MemoryRecallResult" } } } }
      ]
    },

    "VectorEncoding": {
      "description": "§7.3.1: how dense vectors are carried. `json` is an array of numbers and is always supported; `f32-base64` is little-endian IEEE-754 binary32 concatenated and base64-encoded.",
      "enum": ["json", "f32-base64"]
    },

    "VectorBatch": {
      "description": "§7.3.1: a batch of dense vectors — either JSON number arrays, or one base64 string per vector under a binary encoding.",
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "array", "items": { "type": "number" } },
          { "type": "string", "contentEncoding": "base64" }
        ]
      }
    },

    "PeerInfo": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "Capabilities": {
      "type": "object",
      "properties": {
        "embed": {
          "type": "object",
          "properties": {
            "dimension": { "type": "integer", "minimum": 1 },
            "identity": { "type": "string" },
            "batchLimit": { "type": "integer", "minimum": 1 },
            "normalized": { "type": "boolean" },
            "modalities": { "type": "array", "items": { "enum": ["text", "image", "audio", "code", "multimodal"] } }
          }
        },
        "sparseEmbed": {
          "type": "object",
          "properties": {
            "identity": { "type": "string" },
            "vocabulary": { "type": "integer", "minimum": 1 }
          }
        },
        "multiVector": {
          "type": "object",
          "properties": {
            "dimension": { "type": "integer", "minimum": 1 },
            "identity": { "type": "string" },
            "similarity": { "enum": ["dot", "cosine"] },
            "modalities": { "type": "array", "items": { "enum": ["text", "image", "audio", "code", "multimodal"] } }
          }
        },
        "rerank": {
          "type": "object",
          "properties": {
            "methods": { "type": "array", "items": { "enum": ["cross-encoder", "colbert", "llm"] } },
            "maxCandidates": { "type": "integer", "minimum": 1 },
            "models": { "type": "array", "items": { "type": "string" } }
          }
        },
        "retrieve": {
          "type": "object",
          "properties": {
            "maxK": { "type": "integer", "minimum": 1 },
            "modes": { "type": "array", "items": { "enum": ["dense", "sparse", "hybrid"] } },
            "modalities": { "type": "array", "items": { "enum": ["text", "image", "audio", "code", "multimodal"] } },
            "fusion": { "type": "array", "items": { "enum": ["rrf", "weighted", "convex"] } },
            "mmr": { "type": "boolean" },
            "rerankBuiltin": { "type": "boolean" },
            "deterministic": { "type": "boolean" },
            "snapshots": { "type": "boolean" },
            "units": { "type": "array", "items": { "enum": ["chunk", "passage", "document", "node", "triplet", "path", "subgraph", "community", "tree-node", "page"] } },
            "levels": { "type": "integer", "minimum": 1 },
            "tokenBudget": { "type": "boolean" },
            "confidence": { "type": "boolean" },
            "scoreScale": { "enum": ["cosine", "dot", "bm25", "probability", "unbounded"] },
            "scoreFloor": { "type": "number" },
            "defaultMode": { "enum": ["dense", "sparse", "hybrid"] }
          }
        },
        "transform": {
          "type": "object",
          "properties": {
            "methods": { "type": "array", "items": { "enum": ["rewrite", "hyde", "multi-query", "decompose", "step-back"] } }
          }
        },
        "graph": {
          "type": "object",
          "properties": { "ops": { "type": "array", "items": { "type": "string" } } }
        },
        "index": {
          "type": "object",
          "properties": {
            "writable": { "type": "boolean" },
            "chunking": { "type": "boolean" },
            "contextual": { "type": "boolean" }
          }
        },
        "session": {
          "type": "object",
          "properties": {
            "dedup": { "type": "boolean" },
            "ttlSeconds": { "type": "integer", "minimum": 0 }
          }
        },
        "feedback": { "type": "object" },
        "memory": {
          "type": "object",
          "properties": {
            "scopes": { "type": "array", "items": { "enum": ["global", "session"] } },
            "clues": { "type": "boolean" }
          }
        },
        "filter": {
          "type": "object",
          "properties": {
            "fields": {
              "oneOf": [
                { "type": "array", "items": { "type": "string" } },
                { "type": "object", "additionalProperties": { "type": "string" } }
              ]
            },
            "operators": { "type": "array", "items": { "type": "string" } }
          }
        },
        "streaming": { "type": "object" },
        "pagination": { "type": "object" },
        "citations": {
          "oneOf": [ { "type": "boolean" }, { "type": "object" } ]
        },
        "log": { "type": "object", "properties": { "levels": { "type": "array", "items": { "type": "string" } } } },
        "catalog": { "type": "object" }
      },
      "additionalProperties": true
    },
    "Content": {
      "description": "A tagged content block for multimodal retrieval (spec §4.8). A block carries its body EITHER inline as base64 `data` OR by reference as `uri`, never both. Non-text blocks MUST declare a `mimeType`; a `text` block MUST carry `text`.",
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["text", "image", "audio", "blob"] },
        "text": { "type": "string" },
        "mimeType": { "type": "string" },
        "data": { "type": "string", "contentEncoding": "base64" },
        "uri": { "type": "string", "format": "uri" }
      },
      "not": { "required": ["data", "uri"] },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "text" } }, "required": ["type"] },
          "then": { "required": ["text"] },
          "else": { "required": ["mimeType"], "anyOf": [{ "required": ["data"] }, { "required": ["uri"] }] }
        }
      ]
    },
    "QueryInput": {
      "description": "A query/passage: a bare string, one Content block, or an array of them.",
      "oneOf": [
        { "type": "string" },
        { "$ref": "#/$defs/Content" },
        { "type": "array", "items": { "$ref": "#/$defs/Content" } }
      ]
    },
    "Citation": {
      "type": "object",
      "properties": {
        "source": { "type": "string" },
        "uri": { "type": "string" },
        "title": { "type": "string" },
        "start": { "type": "integer" },
        "end": { "type": "integer" },
        "page": { "type": "integer" }
      }
    },
    "Trust": {
      "type": "object",
      "required": ["level"],
      "properties": {
        "level": { "enum": ["trusted", "community", "untrusted"] },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "injectionSuspected": { "type": "boolean" },
        "sanitized": { "type": "boolean" }
      }
    },
    "Provenance": {
      "description": "Graph/tree lineage behind a hit (spec §7.7.2).",
      "type": "object",
      "properties": {
        "path": { "type": "array", "items": { "type": "string" } },
        "nodes": { "type": "array", "items": { "type": "string" } },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["src", "dst"],
            "properties": { "src": { "type": "string" }, "dst": { "type": "string" } }
          }
        },
        "leaves": { "type": "array", "items": { "type": "string" } }
      }
    },
    "Hit": {
      "type": "object",
      "required": ["id", "score"],
      "properties": {
        "id": { "type": ["string", "number"] },
        "score": { "type": "number" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "text": { "type": "string" },
        "content": { "type": "array", "items": { "$ref": "#/$defs/Content" } },
        "modality": { "enum": ["text", "image", "audio", "code", "multimodal"] },
        "unit": { "enum": ["chunk", "passage", "document", "node", "triplet", "path", "subgraph", "community", "tree-node", "page"] },
        "level": { "type": "integer", "minimum": 0 },
        "meta": { "type": "object" },
        "vector": { "type": "array", "items": { "type": "number" } },
        "scores": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "citation": { "$ref": "#/$defs/Citation" },
        "provenance": { "$ref": "#/$defs/Provenance" },
        "trust": { "$ref": "#/$defs/Trust" },
        "chunk": {
          "type": "object",
          "properties": {
            "docId": { "type": "string" },
            "index": { "type": "integer" },
            "context": { "type": "string" }
          }
        }
      }
    },
    "SparseVector": {
      "type": "object",
      "required": ["indices", "values"],
      "properties": {
        "indices": { "type": "array", "items": { "type": "integer" } },
        "values": { "type": "array", "items": { "type": "number" } }
      }
    },
    "FilterClause": {
      "type": "object",
      "oneOf": [
        {
          "required": ["field", "op"],
          "properties": {
            "field": { "type": "string" },
            "op": { "enum": ["eq", "ne", "gt", "gte", "lt", "lte", "in", "nin", "contains", "exists"] },
            "value": {}
          }
        },
        { "required": ["and"], "properties": { "and": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/FilterClause" } } } },
        { "required": ["or"], "properties": { "or": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/FilterClause" } } } },
        { "required": ["not"], "properties": { "not": { "$ref": "#/$defs/FilterClause" } } }
      ]
    },
    "JsonRpcRequest": {
      "description": "A call that expects exactly one response. §4.1: `id` MUST be a string or number and unique for the connection until answered — it is NOT nullable on a request (a null id belongs to an error response to an unparseable frame), and its absence makes the frame a notification instead.",
      "type": "object",
      "required": ["jsonrpc", "id", "method"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/RequestId" },
        "method": { "$ref": "#/$defs/MethodName" },
        "params": { "type": "object" }
      },
      "allOf": [
        { "if": { "properties": { "method": { "const": "initialize" } }, "required": ["method"] },
          "then": { "properties": { "params": { "$ref": "#/$defs/InitializeParams" } }, "required": ["params"] } },
        { "if": { "properties": { "method": { "const": "embed" } }, "required": ["method"] },
          "then": { "properties": { "params": { "$ref": "#/$defs/EmbedParams" } }, "required": ["params"] } },
        { "if": { "properties": { "method": { "const": "rerank" } }, "required": ["method"] },
          "then": { "properties": { "params": { "$ref": "#/$defs/RerankParams" } }, "required": ["params"] } },
        { "if": { "properties": { "method": { "const": "retrieve" } }, "required": ["method"] },
          "then": { "properties": { "params": { "$ref": "#/$defs/RetrieveParams" } }, "required": ["params"] } },
        { "if": { "properties": { "method": { "const": "query/transform" } }, "required": ["method"] },
          "then": { "properties": { "params": { "$ref": "#/$defs/TransformParams" } }, "required": ["params"] } },
        { "if": { "properties": { "method": { "const": "graph" } }, "required": ["method"] },
          "then": { "properties": { "params": { "$ref": "#/$defs/GraphParams" } }, "required": ["params"] } },
        { "if": { "properties": { "method": { "const": "index/add" } }, "required": ["method"] },
          "then": { "properties": { "params": { "$ref": "#/$defs/IndexAddParams" } }, "required": ["params"] } },
        { "if": { "properties": { "method": { "const": "index/delete" } }, "required": ["method"] },
          "then": { "properties": { "params": { "$ref": "#/$defs/IndexDeleteParams" } }, "required": ["params"] } },
        { "if": { "properties": { "method": { "const": "feedback" } }, "required": ["method"] },
          "then": { "properties": { "params": { "$ref": "#/$defs/FeedbackParams" } }, "required": ["params"] } },
        { "if": { "properties": { "method": { "const": "memory/build" } }, "required": ["method"] },
          "then": { "properties": { "params": { "$ref": "#/$defs/MemoryBuildParams" } }, "required": ["params"] } },
        { "if": { "properties": { "method": { "const": "ping" } }, "required": ["method"] },
          "then": { "properties": { "params": { "$ref": "#/$defs/PingParams" } } } },
        { "if": { "properties": { "method": { "const": "catalog/list" } }, "required": ["method"] },
          "then": { "properties": { "params": { "$ref": "#/$defs/CatalogListParams" } } } },
        { "if": { "properties": { "method": { "const": "memory/recall" } }, "required": ["method"] },
          "then": { "properties": { "params": { "$ref": "#/$defs/MemoryRecallParams" } }, "required": ["params"] } }
      ]
    },

    "RequestId": {
      "description": "§4.1/§4.7: a request id is a string or a number. Numbers SHOULD be integers in the IEEE-754 exactly-representable range so an id survives a round trip through any JSON stack.",
      "type": ["string", "number"]
    },

    "JsonRpcNotification": {
      "description": "§4.5: a frame with NO `id`. It MUST NOT be answered — not even with an error.",
      "type": "object",
      "required": ["jsonrpc", "method"],
      "not": { "required": ["id"] },
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "type": "string" },
        "params": { "type": "object" }
      },
      "allOf": [
        { "if": { "properties": { "method": { "const": "notifications/progress" } }, "required": ["method"] },
          "then": { "$ref": "#/$defs/ProgressNotification" } },
        { "if": { "properties": { "method": { "const": "notifications/cancel" } }, "required": ["method"] },
          "then": { "$ref": "#/$defs/CancelNotification" } },
        { "if": { "properties": { "method": { "const": "notifications/log" } }, "required": ["method"] },
          "then": { "$ref": "#/$defs/LogNotification" } }
      ]
    },

    "JsonRpcSuccess": {
      "description": "A successful response. `id` MUST equal the id of the request being answered (§4.2).",
      "type": "object",
      "required": ["jsonrpc", "id", "result"],
      "not": { "required": ["error"] },
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/RequestId" },
        "result": { "type": "object" }
      }
    },
    "JsonRpcError": {
      "description": "An error response (§4.3). `id` echoes the request; it is null ONLY when the request could not be parsed well enough to recover one.",
      "type": "object",
      "required": ["jsonrpc", "id", "error"],
      "not": { "required": ["result"] },
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": ["string", "number", "null"] },
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "$ref": "#/$defs/ErrorCode" },
            "message": { "type": "string" },
            "data": { "$ref": "#/$defs/ErrorData" }
          }
        }
      }
    },

    "ErrorCode": {
      "description": "§12. JSON-RPC reserved codes plus the RCP range. Codes outside these sets are reserved for future revisions; a receiver MUST treat an unknown code as a generic failure rather than rejecting the frame.",
      "type": "integer",
      "anyOf": [
        { "enum": [
          -32700, -32600, -32601, -32602, -32603,
          -32001, -32002, -32003, -32004, -32005, -32006,
          -32010, -32011,
          -32012, -32013, -32014, -32015, -32016
        ] },
        { "type": "integer" }
      ]
    },
    "ProgressNotification": {
      "type": "object",
      "required": ["jsonrpc", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "const": "notifications/progress" },
        "params": {
          "type": "object",
          "required": ["progressToken"],
          "properties": {
            "progressToken": { "type": ["string", "integer"] },
            "progress": { "type": "number", "minimum": 0, "maximum": 1 },
            "stage": { "type": "string" },
            "message": { "type": "string" },
            "partial": { "type": "object" }
          }
        }
      }
    },
    "InitializeParams": {
      "type": "object",
      "required": ["protocolVersion"],
      "properties": {
        "protocolVersion": { "type": "integer", "minimum": 1 },
        "client": { "$ref": "#/$defs/PeerInfo" },
        "capabilities": { "$ref": "#/$defs/Capabilities" },
        "_meta": { "type": "object" }
      }
    },
    "InitializeResult": {
      "type": "object",
      "required": ["protocolVersion", "server", "capabilities"],
      "properties": {
        "protocolVersion": { "type": "integer", "minimum": 1 },
        "server": { "$ref": "#/$defs/PeerInfo" },
        "capabilities": { "$ref": "#/$defs/Capabilities" }
      }
    },
    "EmbedParams": {
      "type": "object",
      "anyOf": [{ "required": ["inputs"] }, { "required": ["texts"] }],
      "properties": {
        "inputs": { "type": "array", "items": { "oneOf": [{ "type": "string" }, { "$ref": "#/$defs/Content" }] } },
        "texts": { "type": "array", "items": { "oneOf": [{ "type": "string" }, { "$ref": "#/$defs/Content" }] } },
        "kind": { "enum": ["query", "document"] },
        "encoding": { "$ref": "#/$defs/VectorEncoding" }
      }
    },
    "EmbedResult": {
      "type": "object",
      "required": ["vectors"],
      "$comment": "§7.3.1: when `encoding` is f32-base64, `dimension` MUST be present and each decoded blob MUST be exactly dimension×4 bytes.",
      "properties": {
        "vectors": { "$ref": "#/$defs/VectorBatch" },
        "encoding": { "$ref": "#/$defs/VectorEncoding" },
        "dimension": { "type": "integer", "minimum": 1 }
      },
      "if": { "properties": { "encoding": { "const": "f32-base64" } }, "required": ["encoding"] },
      "then": { "required": ["dimension"] }
    },
    "SparseEmbedResult": {
      "type": "object",
      "required": ["sparse"],
      "properties": { "sparse": { "type": "array", "items": { "$ref": "#/$defs/SparseVector" } } }
    },
    "MultiVectorResult": {
      "type": "object",
      "required": ["matrices"],
      "properties": {
        "matrices": {
          "type": "array",
          "items": { "type": "array", "items": { "type": "array", "items": { "type": "number" } } }
        },
        "dimension": { "type": "integer", "minimum": 1 }
      }
    },
    "RerankParams": {
      "type": "object",
      "required": ["query", "passages"],
      "properties": {
        "query": { "$ref": "#/$defs/QueryInput" },
        "passages": { "type": "array", "items": { "oneOf": [ { "type": "string" }, { "$ref": "#/$defs/Content" } ] } },
        "method": { "enum": ["cross-encoder", "colbert", "llm"] },
        "model": { "type": "string" },
        "topN": { "type": "integer", "minimum": 1 }
      }
    },
    "RerankResult": {
      "type": "object",
      "required": ["scores"],
      "properties": {
        "scores": { "type": "array", "items": { "type": "number" } },
        "order": { "type": "array", "items": { "type": "integer" } }
      }
    },
    "RetrieveParams": {
      "type": "object",
      "required": ["query", "k"],
      "properties": {
        "query": { "$ref": "#/$defs/QueryInput" },
        "k": { "type": "integer", "minimum": 1 },
        "mode": { "enum": ["dense", "sparse", "hybrid"] },
        "modality": { "enum": ["text", "image", "audio", "code", "multimodal"] },
        "candidateK": { "type": "integer", "minimum": 1 },
        "fusion": {
          "type": "object",
          "properties": {
            "method": { "enum": ["rrf", "weighted", "convex"] },
            "weights": { "type": "object", "additionalProperties": { "type": "number" } },
            "rrfK": { "type": "integer" },
            "alpha": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "rerank": {
          "oneOf": [
            { "type": "object", "properties": { "method": { "enum": ["cross-encoder", "colbert", "llm"] }, "model": { "type": "string" }, "topN": { "type": "integer" } } },
            { "const": false }
          ]
        },
        "mmr": { "type": "object", "properties": { "lambda": { "type": "number", "minimum": 0, "maximum": 1 } } },
        "rewrite": { "oneOf": [{ "enum": ["rewrite", "hyde", "multi-query", "decompose", "step-back"] }, { "const": false }] },
        "filter": { "$ref": "#/$defs/FilterClause" },
        "minScore": { "type": "number" },
        "recency": { "type": "object", "properties": { "field": { "type": "string" }, "halfLifeDays": { "type": "number" } } },
        "unit": { "enum": ["chunk", "passage", "document", "node", "triplet", "path", "subgraph", "community", "tree-node", "page"] },
        "level": { "type": "integer", "minimum": 0 },
        "tokenBudget": { "type": "integer", "minimum": 1 },
        "sessionId": { "type": "string" },
        "includeText": { "type": "boolean" },
        "includeVectors": { "type": "boolean" },
        "seed": { "type": "integer" },
        "indexVersion": { "type": "string" },
        "strict": { "type": "boolean" },
        "cursor": { "type": "string" },
        "_meta": { "type": "object" }
      }
    },
    "RetrieveResult": {
      "type": "object",
      "required": ["hits"],
      "properties": {
        "hits": { "type": "array", "items": { "$ref": "#/$defs/Hit" } },
        "nextCursor": { "type": "string" },
        "indexVersion": { "type": "string" },
        "usage": { "type": "object" },
        "rewrittenQuery": { "type": "string" }
      }
    },
    "GraphResult": {
      "description": "§7.9: the `graph` result is op-specific. Each branch is the shape required for one `op`; a server MAY include extra keys (§4.6 forward compatibility).",
      "type": "object",
      "anyOf": [
        { "required": ["hits"] },
        { "required": ["communities"] },
        { "required": ["nodes"] }
      ],
      "properties": {
        "hits": { "type": "array", "items": { "$ref": "#/$defs/Hit" } },
        "followups": { "type": "array", "items": { "type": "string" } },
        "summary": { "type": "string" },
        "communities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "type": ["string", "number"] },
              "summary": { "type": "string" },
              "score": { "type": "number" },
              "level": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "type": ["string", "number"] },
              "score": { "type": "number" }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["src", "dst"],
            "properties": {
              "src": { "type": ["string", "number"] },
              "dst": { "type": ["string", "number"] },
              "weight": { "type": "number" }
            }
          }
        },
        "nextCursor": { "type": "string" },
        "usage": { "type": "object" },
        "_meta": { "type": "object" }
      }
    },

    "TransformParams": {
      "type": "object",
      "required": ["query", "method"],
      "properties": {
        "query": { "type": "string" },
        "method": { "enum": ["rewrite", "hyde", "multi-query", "decompose", "step-back"] },
        "n": { "type": "integer", "minimum": 1 }
      }
    },
    "TransformResult": {
      "type": "object",
      "required": ["queries"],
      "properties": {
        "queries": { "type": "array", "items": { "type": "string" } },
        "hypothetical": { "type": "string" }
      }
    },
    "GraphParams": {
      "type": "object",
      "required": ["op"],
      "properties": {
        "op": { "enum": ["local", "global", "drift", "communities", "neighbors"] },
        "query": { "type": "string" },
        "k": { "type": "integer", "minimum": 1 },
        "seedIds": { "type": "array", "items": { "type": "string" } },
        "hops": { "type": "integer", "minimum": 1 },
        "level": { "type": "integer", "minimum": 0 },
        "sessionId": { "type": "string" }
      }
    },
    "FeedbackParams": {
      "type": "object",
      "required": ["signals"],
      "properties": {
        "sessionId": { "type": "string" },
        "query": { "type": "string" },
        "signals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["hitId"],
            "properties": {
              "hitId": { "type": ["string", "number"] },
              "used": { "type": "boolean" },
              "cited": { "type": "boolean" },
              "helpful": { "type": "boolean" },
              "reward": { "type": "number", "minimum": -1, "maximum": 1 },
              "poisonSuspected": { "type": "boolean" },
              "injectionSuspected": { "type": "boolean" }
            }
          }
        }
      }
    },
    "FeedbackResult": {
      "type": "object",
      "required": ["accepted"],
      "properties": { "accepted": { "type": "integer", "minimum": 0 } }
    },
    "MemoryBuildParams": {
      "type": "object",
      "properties": {
        "documents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text"],
            "properties": { "id": { "type": "string" }, "text": { "type": "string" } }
          }
        },
        "memoryId": { "type": "string" },
        "scope": { "enum": ["global", "session"] }
      }
    },
    "MemoryBuildResult": {
      "type": "object",
      "required": ["memoryId"],
      "properties": {
        "memoryId": { "type": "string" },
        "tokens": { "type": "integer", "minimum": 0 }
      }
    },
    "MemoryRecallParams": {
      "type": "object",
      "required": ["query"],
      "properties": {
        "query": { "type": "string" },
        "memoryId": { "type": "string" },
        "sessionId": { "type": "string" },
        "n": { "type": "integer", "minimum": 1 }
      }
    },
    "MemoryRecallResult": {
      "type": "object",
      "required": ["clues"],
      "properties": {
        "clues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "query": { "type": "string" },
              "seedIds": { "type": "array", "items": { "type": "string" } },
              "weight": { "type": "number" }
            }
          }
        },
        "hits": { "type": "array", "items": { "$ref": "#/$defs/Hit" } }
      }
    },
    "IndexAddParams": {
      "type": "object",
      "required": ["documents"],
      "properties": {
        "documents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text"],
            "properties": {
              "id": { "type": "string" },
              "text": { "type": "string" },
              "meta": { "type": "object" }
            }
          }
        },
        "chunk": { "type": "boolean" },
        "contextual": { "type": "boolean" }
      }
    },
    "IndexAddResult": {
      "type": "object",
      "required": ["ids"],
      "properties": {
        "ids": { "type": "array", "items": { "type": "string" } },
        "chunks": { "type": "integer" }
      }
    },
    "IndexDeleteParams": {
      "type": "object",
      "required": ["ids"],
      "properties": { "ids": { "type": "array", "items": { "type": "string" } } }
    },
    "IndexDeleteResult": {
      "type": "object",
      "required": ["deleted"],
      "properties": { "deleted": { "type": "integer", "minimum": 0 } }
    },
    "CatalogListParams": { "type": "object" },
    "CatalogListResult": {
      "type": "object",
      "required": ["engines"],
      "properties": {
        "engines": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "server", "capabilities"],
            "properties": {
              "id": { "type": "string" },
              "server": { "$ref": "#/$defs/PeerInfo" },
              "capabilities": { "$ref": "#/$defs/Capabilities" },
              "endpoint": {
                "type": "object",
                "required": ["transport"],
                "properties": {
                  "transport": { "enum": ["stdio", "http"] },
                  "url": { "type": "string" },
                  "command": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        }
      }
    },
    "CancelNotification": {
      "type": "object",
      "required": ["jsonrpc", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "const": "notifications/cancel" },
        "params": {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": { "type": ["string", "number"] },
            "reason": { "type": "string" }
          }
        }
      }
    },
    "PingParams": {
      "type": "object",
      "properties": { "nonce": { "type": ["string", "number"] } }
    },
    "PingResult": {
      "type": "object",
      "properties": { "nonce": { "type": ["string", "number"] } }
    },
    "LogNotification": {
      "type": "object",
      "required": ["jsonrpc", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "const": "notifications/log" },
        "params": {
          "type": "object",
          "required": ["level", "message"],
          "properties": {
            "level": { "enum": ["debug", "info", "notice", "warning", "error"] },
            "message": { "type": "string" },
            "logger": { "type": "string" },
            "data": { "type": "object" },
            "_meta": { "type": "object" }
          }
        }
      }
    },
    "ErrorData": {
      "type": "object",
      "properties": {
        "field": { "type": "string" },
        "option": { "type": "string" },
        "retryable": { "type": "boolean" },
        "retryAfterMs": { "type": "integer", "minimum": 0 },
        "detail": { "type": "string" }
      }
    },
    "Registry": {
      "type": "object",
      "required": ["engines"],
      "description": "An rcp.json engine registry (spec §16.1).",
      "properties": {
        "engines": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "type": "string" },
              "transport": { "enum": ["stdio", "http"] },
              "command": { "type": "array", "items": { "type": "string" } },
              "url": { "type": "string" },
              "priority": { "type": "integer" },
              "weight": { "type": "number", "minimum": 0 },
              "required": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
